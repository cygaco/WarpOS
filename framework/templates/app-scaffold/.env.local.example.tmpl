# {{SLUG}} — local environment (copy to .env.local; .env* is gitignored)
# Names only, no values. Add your product's keys as features need them.

# Public app name (safe to expose to the browser).
NEXT_PUBLIC_APP_NAME={{SLUG}}

# Optional analytics sink. The scaffold telemetry seam no-ops when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Pre-PMF admin gate. Production requires a signed admin session cookie.
# ADMIN_DEV_EMAIL is ignored in production.
ADMIN_FOUNDER_EMAILS=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_COOKIE=
ADMIN_DEV_EMAIL=
