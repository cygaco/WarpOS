import { NextResponse, type NextRequest } from "next/server";
import { createSupabaseServerClient } from "@/lib/supabase/server";
import { isSupabaseConfigured } from "@/lib/supabase/config";
// Open-redirect defense (RT-201/CWE-601): parse-then-verify-same-origin. A naive
// leading-slash check is defeated by control chars the URL parser strips mid-parse
// (/%0D/evil.com -> //evil.com). Extracted + unit-tested in safe-next.test.mjs.
import { safeNextPath } from "@/lib/supabase/safe-next";

// PKCE code-exchange callback. Supabase redirects here after the user clicks the
// magic link / completes OAuth; we exchange the one-time `code` for a session
// (cookies persisted via the middleware/server cookie adapter), then redirect to
// the sanitized `next`. no-store so the exchange response is never cached.
export async function GET(request: NextRequest) {
  const url = new URL(request.url);
  const code = url.searchParams.get("code");
  const next = safeNextPath(url.searchParams.get("next"), url.origin);

  const withNoStore = (response: NextResponse): NextResponse => {
    response.headers.set("Cache-Control", "no-store");
    return response;
  };

  if (!isSupabaseConfigured() || !code) {
    return withNoStore(
      NextResponse.redirect(new URL("/auth?error=auth_unavailable", url.origin)),
    );
  }

  const supabase = await createSupabaseServerClient();
  if (!supabase) {
    return withNoStore(
      NextResponse.redirect(new URL("/auth?error=auth_unavailable", url.origin)),
    );
  }

  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) {
    return withNoStore(
      NextResponse.redirect(new URL("/auth?error=exchange_failed", url.origin)),
    );
  }

  return withNoStore(NextResponse.redirect(new URL(next, url.origin)));
}
