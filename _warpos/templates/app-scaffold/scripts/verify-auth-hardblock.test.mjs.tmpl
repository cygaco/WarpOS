// verify-auth-hardblock.test.mjs — planted-violation test proving the hard-block
// verifier is NOT a no-op that always greens.
//
// Runs the verifier's pure static-check core against BOTH file fixtures:
//   present/ -> definition VALID (green)
//   absent/  -> REJECTED (red)   <-- the teeth: if this ever passes, the gate is broken
// plus inline near-miss cases (wrong table, AFTER timing, missing FOR EACH ROW,
// RETURN OLD, comment-only mention) that a grep-based check would false-green.
//
// Works both in a materialized app (verifier is verify-auth-hardblock.mjs) and in
// the .tmpl template repo (verifier is verify-auth-hardblock.mjs.tmpl — copied to a
// temp .mjs so Node can import it). Set HARDBLOCK_SCRIPTS_DIR to point at the
// scripts/ dir when this test file itself is run from a copied location.

import { test } from "node:test";
import assert from "node:assert/strict";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

function scriptsDir() {
  const env = process.env.HARDBLOCK_SCRIPTS_DIR;
  if (env && fs.existsSync(env)) return env;
  return path.dirname(fileURLToPath(import.meta.url));
}

async function loadVerifier(dir) {
  const asMjs = path.join(dir, "verify-auth-hardblock.mjs");
  const asTmpl = path.join(dir, "verify-auth-hardblock.mjs.tmpl");
  let src;
  if (fs.existsSync(asMjs)) {
    src = asMjs;
  } else if (fs.existsSync(asTmpl)) {
    // Node imports by extension; copy the template to a temp .mjs so it loads.
    src = path.join(os.tmpdir(), `verify-auth-hardblock.${process.pid}.mjs`);
    fs.copyFileSync(asTmpl, src);
  } else {
    throw new Error(`verifier not found next to test in ${dir}`);
  }
  return import(pathToFileURL(src).href);
}

const dir = scriptsDir();
const fixtures = path.join(dir, "__fixtures__", "auth-hardblock");

test("present fixture => definition VALID (green)", async () => {
  const { staticCheckMigration } = await loadVerifier(dir);
  const sql = fs.readFileSync(path.join(fixtures, "present", "0001_password_hardblock.sql"), "utf8");
  const res = staticCheckMigration(sql);
  assert.equal(res.valid, true, `expected valid; got ${res.reason}`);
});

test("absent fixture => REJECTED (red) — the gate has teeth", async () => {
  const { staticCheckMigration } = await loadVerifier(dir);
  const sql = fs.readFileSync(path.join(fixtures, "absent", "0001_password_hardblock.sql"), "utf8");
  const res = staticCheckMigration(sql);
  assert.equal(res.valid, false, "absent hard-block MUST be rejected — else the verifier is a no-op");
});

test("the SHIPPED migration is itself valid", async () => {
  const { staticCheckMigration, resolveMigrationPath } = await loadVerifier(dir);
  const migPath = resolveMigrationPath(dir, null);
  assert.ok(migPath, "shipped migration file should be resolvable");
  const res = staticCheckMigration(fs.readFileSync(migPath, "utf8"));
  assert.equal(res.valid, true, `shipped migration must be valid; got ${res.reason}`);
});

// ---- near-miss cases: each is a subtle break a grep would false-green --------

const FN = `CREATE OR REPLACE FUNCTION public.hardblock_password()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN NEW.encrypted_password := NULL; RETURN NEW; END; $$;`;

const nearMisses = {
  "wrong table (public.profiles, not auth.users)": `${FN}
DROP TRIGGER IF EXISTS t ON public.profiles;
CREATE TRIGGER t BEFORE INSERT OR UPDATE ON public.profiles
  FOR EACH ROW EXECUTE FUNCTION public.hardblock_password();`,

  "AFTER timing (cannot mutate NEW)": `${FN}
CREATE TRIGGER t AFTER INSERT OR UPDATE ON auth.users
  FOR EACH ROW EXECUTE FUNCTION public.hardblock_password();`,

  "missing FOR EACH ROW (statement-level)": `${FN}
CREATE TRIGGER t BEFORE INSERT OR UPDATE ON auth.users
  EXECUTE FUNCTION public.hardblock_password();`,

  "function RETURN OLD (discards the null-out)": `CREATE OR REPLACE FUNCTION public.hardblock_password()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN NEW.encrypted_password := NULL; RETURN OLD; END; $$;
CREATE TRIGGER t BEFORE INSERT OR UPDATE ON auth.users
  FOR EACH ROW EXECUTE FUNCTION public.hardblock_password();`,

  "only INSERT (UPDATE path left open)": `${FN}
CREATE TRIGGER t BEFORE INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION public.hardblock_password();`,

  "comment-only mention of encrypted_password": `-- we should null NEW.encrypted_password on auth.users BEFORE INSERT OR UPDATE
CREATE TABLE IF NOT EXISTS public.notes (id uuid PRIMARY KEY);`,

  "trigger references an undefined function": `CREATE TRIGGER t BEFORE INSERT OR UPDATE ON auth.users
  FOR EACH ROW EXECUTE FUNCTION public.does_not_exist();`,

  "empty migration": ``,
};

for (const [label, sql] of Object.entries(nearMisses)) {
  test(`near-miss REJECTED: ${label}`, async () => {
    const { staticCheckMigration } = await loadVerifier(dir);
    const res = staticCheckMigration(sql);
    assert.equal(res.valid, false, `near-miss "${label}" must be rejected`);
  });
}

// ── LIVE-path installed-proof teeth (selectInstalledTarget) ──────────────────────
// The live verifier once fell back to "any trigger whose body nulls encrypted_password"
// when the shipped trigger was absent — a residual false-green (security review). These
// prove the fallback is gone: installed-proof requires the EXACT shipped identity.
const SHIPPED = { name: "hardblock_password_trigger", fn: "hardblock_password", bodyOk: true };
const SUBSTITUTE = { name: "some_other_audit_trigger", fn: "audit_wipe_password", bodyOk: true };

test("live target-selection: shipped identity present => selected", async () => {
  const { selectInstalledTarget } = await loadVerifier(dir);
  assert.ok(selectInstalledTarget([SHIPPED]), "the exact shipped trigger must be selected");
});

test("live target-selection: ONLY a substitute body-nulling trigger, shipped ABSENT => null (the removed false-green)", async () => {
  const { selectInstalledTarget } = await loadVerifier(dir);
  assert.equal(
    selectInstalledTarget([SUBSTITUTE]),
    null,
    "a substitute trigger that nulls the password is NOT proof the shipped hard-block is installed",
  );
});

test("live target-selection: shipped + substitute both present => the SHIPPED one is selected", async () => {
  const { selectInstalledTarget } = await loadVerifier(dir);
  assert.equal(selectInstalledTarget([SUBSTITUTE, SHIPPED]).name, SHIPPED.name);
});

test("live target-selection: no triggers => null", async () => {
  const { selectInstalledTarget } = await loadVerifier(dir);
  assert.equal(selectInstalledTarget([]), null);
});
