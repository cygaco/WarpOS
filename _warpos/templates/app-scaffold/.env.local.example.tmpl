# {{SLUG}} — local environment (copy to .env.local; .env* is gitignored)
# Names only, no values. Add your product's keys as features need them.

# Public app name (safe to expose to the browser).
NEXT_PUBLIC_APP_NAME={{SLUG}}

# Optional analytics sink. The scaffold telemetry seam no-ops when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Pre-PMF admin gate. Production requires a signed admin session cookie.
# ADMIN_DEV_EMAIL is ignored in production.
# The session cookie EXPIRES after 7 days; bump ADMIN_SESSION_VERSION to revoke every
# issued session at once (e.g. after a suspected leak). Defaults to "1" if unset.
ADMIN_FOUNDER_EMAILS=
# ADMIN_SESSION_SECRET signs the admin cookie — use a HIGH-ENTROPY value (>= 32 random
# bytes), e.g. `openssl rand -base64 32`. A weak/guessable secret defeats the whole gate.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_COOKIE=
ADMIN_SESSION_VERSION=1
ADMIN_DEV_EMAIL=

# Input composer — voice-to-text (flag-ON path only; see
# src/hooks/useVoiceInput.ts + _knowledge/design/INPUT_COMPOSER_PATTERN.md §4).
# Flag-OFF (default) uses the browser's Web Speech API and needs no server.
# When voiceEnabled is true, the composer POSTs the recorded audio blob here.
# This is a DOCUMENTED SEAM ONLY — the transcription route itself
# (e.g. /api/transcribe, calling out to a provider like OpenAI) is
# PRODUCT-OWNED and is NOT shipped by this scaffold; wire your own route and
# point this at it.
NEXT_PUBLIC_TRANSCRIBE_URL=
