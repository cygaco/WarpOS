@@ -0,0 +1,363 @@
+import type { ReactNode } from "react";
+import {
+  AlertTriangle,
+  ArrowRight,
+  Ban,
+  CheckCircle2,
+  Clock,
+  Flag,
+  Rocket,
+  ShieldCheck,
+} from "lucide-react";
+import { Button } from "@/components/ui/button";
+import {
+  Card,
+  CardContent,
+  CardDescription,
+  CardHeader,
+  CardTitle,
+} from "@/components/ui/card";
+import {
+  founderEmailAllowlist,
+  resolveAdminActor,
+} from "@/lib/admin/config";
+import {
+  groupReadinessItems,
+  longestLeadOpenItemId,
+  readinessPhase,
+  toReadinessView,
+} from "@/lib/readiness/group";
+import type {
+  ReadinessReport,
+  ReadinessViewItem,
+} from "@/lib/readiness/types";
+import { toggleReadinessItemAction } from "./actions";
+
+// The readiness producer is a machine-layer Node (CommonJS) module shipped with the
+// scaffold at the product repo root (scripts/scaffold/readiness-report.js). It runs
+// server-side ONLY; its schema id, product_id, and per-item `source` never cross into the
+// rendered DOM (toReadinessView strips them). Resolved from the project root at request
+// time so the bundler does not try to trace the dev-tooling script into the client bundle.
+function loadReport(): ReadinessReport {
+  const path = require("node:path") as typeof import("node:path");
+  const producerPath = path.join(
+    process.cwd(),
+    "scripts",
+    "scaffold",
+    "readiness-report.js",
+  );
+  // eslint-disable-next-line @typescript-eslint/no-var-requires
+  const { buildReadinessReport } = require(producerPath);
+  return buildReadinessReport(process.cwd(), {
+    generated_at: new Date().toISOString(),
+  }) as ReadinessReport;
+}
+
+function StatusPill({ children }: { children: ReactNode }) {
+  return (
+    <span className="inline-flex rounded-md border px-2 py-1 text-xs font-medium">
+      {children}
+    </span>
+  );
+}
+
+function DimBadge({ dim }: { dim: string }) {
+  return (
+    <span className="inline-flex rounded-md border px-2 py-0.5 text-xs text-muted-foreground">
+      {dim}
+    </span>
+  );
+}
+
+function LeadTimeChip({
+  days,
+  note,
+  startNow,
+}: {
+  days: number;
+  note: string;
+  startNow: boolean;
+}) {
+  return (
+    <div className="flex flex-col gap-1">
+      <span className="inline-flex w-fit items-center gap-1.5 rounded-md border border-accent bg-accent px-2 py-0.5 text-xs font-medium text-accent-foreground">
+        <Clock className="size-3.5" aria-hidden />~{days} days
+      </span>
+      <p className="text-xs text-muted-foreground">
+        {startNow ? (
+          <span className="font-semibold text-foreground">Start now — </span>
+        ) : null}
+        {note}
+      </p>
+    </div>
+  );
+}
+
+function DeepLinkCta({ item }: { item: ReadinessViewItem }) {
+  // No dead links: render the CTA ONLY when the producer resolved a real guide.
+  if (item.deep_link.kind !== "guide") return null;
+  const ref = item.deep_link.ref.replace(/\.md$/i, "");
+  return (
+    <Button
+      asChild
+      variant="outline"
+      size="sm"
+      className="w-full sm:w-fit"
+    >
+      <a
+        href={`/admin/guides/${encodeURIComponent(ref)}`}
+        aria-label={`How to do this: ${item.label}`}
+      >
+        How to do this
+        <ArrowRight className="size-4" aria-hidden />
+      </a>
+    </Button>
+  );
+}
+
+function OpenItemRow({
+  item,
+  startNow,
+}: {
+  item: ReadinessViewItem;
+  startNow: boolean;
+}) {
+  const inputId = `readiness-${item.id}`;
+  return (
+    <div className="flex flex-col gap-3 rounded-md border p-4">
+      <div className="flex items-start gap-3">
+        {/* Progressive-enhancement toggle: a real checkbox inside the server-action form.
+            Submitting flips this owner-action item. Only owner-action items are checkable. */}
+        <form
+          action={toggleReadinessItemAction}
+          className="flex items-start gap-3"
+        >
+          <input type="hidden" name="id" value={item.id} />
+          <input type="hidden" name="checked" value="true" />
+          {/* Server-rendered affordance; the form submit drives the toggle. readOnly
+              keeps React happy without a client handler (progressive enhancement). */}
+          <input
+            id={inputId}
+            type="checkbox"
+            readOnly
+            className="mt-0.5 size-[18px] shrink-0 accent-[var(--primary)]"
+          />
+          <label
+            htmlFor={inputId}
+            className="cursor-pointer text-sm font-medium"
+          >
+            {item.label}
+          </label>
+          <button type="submit" className="sr-only">
+            Mark &ldquo;{item.label}&rdquo; as done
+          </button>
+        </form>
+      </div>
+
+      <div className="flex flex-col gap-3 pl-[30px] sm:flex-row sm:flex-wrap sm:items-end sm:justify-between">
+        <div className="flex flex-col gap-2">
+          <DimBadge dim={item.dim} />
+          {item.lead_time ? (
+            <LeadTimeChip
+              days={item.lead_time.days}
+              note={item.lead_time.note}
+              startNow={startNow}
+            />
+          ) : null}
+        </div>
+        <DeepLinkCta item={item} />
+      </div>
+    </div>
+  );
+}
+
+function DoneItemRow({ item }: { item: ReadinessViewItem }) {
+  const inputId = `readiness-${item.id}`;
+  return (
+    <div className="flex flex-col gap-2 rounded-md border p-4 opacity-90">
+      <form action={toggleReadinessItemAction} className="flex items-center gap-3">
+        <input type="hidden" name="id" value={item.id} />
+        <input type="hidden" name="checked" value="false" />
+        <input
+          id={inputId}
+          type="checkbox"
+          defaultChecked
+          className="size-[18px] shrink-0 accent-[var(--primary)]"
+        />
+        <label htmlFor={inputId} className="text-sm text-muted-foreground">
+          {item.label}
+        </label>
+        <span className="inline-flex items-center gap-1 rounded-md border border-primary px-2 py-0.5 text-xs font-medium text-primary">
+          <CheckCircle2 className="size-3.5" aria-hidden />
+          Done
+        </span>
+        <button type="submit" className="sr-only">
+          Mark &ldquo;{item.label}&rdquo; as not done
+        </button>
+      </form>
+    </div>
+  );
+}
+
+function BlockedItemRow({ item }: { item: ReadinessViewItem }) {
+  return (
+    <div className="flex flex-col gap-3 rounded-md border border-destructive/50 p-4">
+      <div className="flex items-start gap-3">
+        <AlertTriangle
+          className="mt-0.5 size-[18px] shrink-0 text-destructive"
+          aria-hidden
+        />
+        <span className="text-sm font-medium">{item.label}</span>
+      </div>
+      <div className="flex items-start gap-2 rounded-md bg-destructive/10 p-3 text-sm text-destructive">
+        <Ban className="mt-0.5 size-4 shrink-0" aria-hidden />
+        <span>Blocked: {item.blocker || "waiting on an external approval"}</span>
+      </div>
+      <DeepLinkCta item={item} />
+    </div>
+  );
+}
+
+export default async function ReadinessPage() {
+  // GATE (default-deny, first action) — copied from admin/page.tsx. Absent / malformed /
+  // non-allowlisted cookie → no content. The prod dev-email fallback fails closed inside
+  // resolveAdminActor (NODE_ENV==="production" → devEmail = "").
+  const actor = await resolveAdminActor();
+  if (!actor.allowed) {
+    const allowedCount = founderEmailAllowlist().length;
+    return (
+      <main className="mx-auto flex min-h-screen max-w-xl flex-col justify-center gap-4 p-8">
+        <Card>
+          <CardHeader>
+            <CardTitle className="flex items-center gap-2">
+              <ShieldCheck className="size-5" aria-hidden />
+              Admin access restricted
+            </CardTitle>
+            <CardDescription>
+              This route is locked to the founder email allowlist. Current actor
+              source: {actor.source}. Allowlisted founders: {allowedCount}.
+            </CardDescription>
+          </CardHeader>
+        </Card>
+      </main>
+    );
+  }
+
+  const view = toReadinessView(loadReport());
+  const { summary, composite } = view;
+  const groups = groupReadinessItems(view);
+  const phase = readinessPhase(summary);
+  const longestId = longestLeadOpenItemId(view);
+
+  const summaryClauses = [
+    `${summary.completed} of ${summary.total} done`,
+    summary.open > 0 ? `${summary.open} to do` : null,
+    summary.blocked > 0 ? `${summary.blocked} blocked` : null,
+  ].filter(Boolean);
+
+  return (
+    <main className="mx-auto flex min-h-screen max-w-4xl flex-col gap-6 p-6">
+      <header className="flex flex-col gap-2 border-b pb-5">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <div>
+            <p className="text-sm text-muted-foreground">Launch readiness</p>
+            <h1 className="text-2xl font-semibold">{{SLUG}}</h1>
+          </div>
+          <StatusPill>{actor.email}</StatusPill>
+        </div>
+      </header>
+
+      <Card>
+        <CardHeader>
+          <CardTitle>{composite}% ready</CardTitle>
+          <CardDescription>{summaryClauses.join(" · ")}</CardDescription>
+        </CardHeader>
+        <CardContent>
+          <div
+            role="progressbar"
+            aria-valuenow={composite}
+            aria-valuemin={0}
+            aria-valuemax={100}
+            aria-label="Launch readiness progress"
+            className="h-2 w-full overflow-hidden rounded-full bg-muted"
+          >
+            <div
+              className="h-full rounded-full bg-primary"
+              style={{ width: `${composite}%` }}
+            />
+          </div>
+        </CardContent>
+      </Card>
+
+      {phase === "cold" ? (
+        <Card className="border-accent bg-accent/30">
+          <CardHeader>
+            <CardTitle className="flex items-center gap-2">
+              <Rocket className="size-5" aria-hidden />
+              Let&rsquo;s get you launch-ready.
+            </CardTitle>
+            <CardDescription className="flex items-start gap-2">
+              <Flag className="mt-0.5 size-4 shrink-0" aria-hidden />
+              <span>
+                Nothing&rsquo;s done yet — that&rsquo;s normal. Start with the
+                items marked &ldquo;Start now&rdquo;: they take real-world time you
+                can&rsquo;t speed up (developer accounts, store reviews). Work top
+                to bottom; check things off as you go.
+              </span>
+            </CardDescription>
+          </CardHeader>
+        </Card>
+      ) : null}
+
+      {phase === "all-done" ? (
+        <Card className="border-primary bg-primary/5">
+          <CardHeader>
+            <CardTitle className="flex items-center gap-2">
+              <CheckCircle2 className="size-5" aria-hidden />
+              You&rsquo;re launch-ready.
+            </CardTitle>
+          </CardHeader>
+        </Card>
+      ) : null}
+
+      {groups.map((group) => {
+        if (group.key === "done") {
+          return (
+            <details key={group.key} className="rounded-md border p-2">
+              <summary className="cursor-pointer px-2 py-1 text-sm font-medium text-muted-foreground">
+                {group.heading}
+              </summary>
+              <div className="mt-3 space-y-3">
+                {group.items.map((item) => (
+                  <DoneItemRow key={item.id} item={item} />
+                ))}
+              </div>
+            </details>
+          );
+        }
+
+        return (
+          <section key={group.key} className="space-y-3">
+            <h2 className="text-sm font-medium text-muted-foreground">
+              {group.heading}
+            </h2>
+            <div className="space-y-3">
+              {group.items.map((item) => {
+                if (group.key === "blocked") {
+                  return <BlockedItemRow key={item.id} item={item} />;
+                }
+                return (
+                  <OpenItemRow
+                    key={item.id}
+                    item={item}
+                    startNow={item.id === longestId}
+                  />
+                );
+              })}
+            </div>
+          </section>
+        );
+      })}
+    </main>
+  );
+}
diff --git a/framework/templates/app-scaffold/src/lib/readiness/group.ts.tmpl b/framework/templates/app-scaffold/src/lib/readiness/group.ts.tmpl
new file mode 100644
index 00000000..b3cd925e
--- /dev/null
+++ b/framework/templates/app-scaffold/src/lib/readiness/group.ts.tmpl
@@ -0,0 +1,110 @@
+// Readiness grouping + ordering — the UI groups and orders; it does NOT preserve the
+// raw producer order (UX spec LIST GROUPING).
+//
+//   1. "Do this first" = open + owner-action, lead-time items first (longest lead-time
+//      / longest real-world pole at the top), then the rest.
+//   2. "Blocked"       = status blocked.
+//   3. "In the sprint" = open + (sprint-work | waiver) — "we're handling these".
+//   4. "Done"          = status done, collapsed by default.
+//
+// 0-item groups are omitted by the caller. Pure + deterministic — no clock, no I/O.
+
+import type {
+  ReadinessGroup,
+  ReadinessPhase,
+  ReadinessReport,
+  ReadinessSummary,
+  ReadinessView,
+  ReadinessViewItem,
+} from "./types";
+
+// Strip the report to the brand-clean view subset (drops schema, product_id, source).
+export function toReadinessView(report: ReadinessReport): ReadinessView {
+  return {
+    composite: report.composite,
+    summary: report.summary,
+    items: report.items.map((it) => ({
+      id: it.id,
+      label: it.label,
+      dim: it.dim,
+      status: it.status,
+      owner_class: it.owner_class,
+      lead_time: it.lead_time,
+      blocker: it.blocker,
+      deep_link: it.deep_link,
+    })),
+  };
+}
+
+// Stable sort: lead-time items first (days desc — longest pole on top), then the rest in
+// their original relative order. JS Array.sort is stable on modern runtimes (V8/Node 12+).
+function orderDoFirst(items: ReadinessViewItem[]): ReadinessViewItem[] {
+  return [...items].sort((a, b) => {
+    const aLead = a.lead_time ? a.lead_time.days : -1;
+    const bLead = b.lead_time ? b.lead_time.days : -1;
+    return bLead - aLead;
+  });
+}
+
+// The id of the single longest-lead-time open owner-action item ("Start now"), or null.
+export function longestLeadOpenItemId(view: ReadinessView): string | null {
+  let best: ReadinessViewItem | null = null;
+  for (const it of view.items) {
+    if (it.status !== "open" || it.owner_class !== "owner-action") continue;
+    if (!it.lead_time) continue;
+    if (!best || !best.lead_time || it.lead_time.days > best.lead_time.days) {
+      best = it;
+    }
+  }
+  return best ? best.id : null;
+}
+
+export function readinessPhase(summary: ReadinessSummary): ReadinessPhase {
+  if (summary.completed === 0) return "cold";
+  if (summary.open === 0 && summary.blocked === 0) return "all-done";
+  return "warm";
+}
+
+// Group + order the view items. Returns ONLY non-empty groups, in display order.
+export function groupReadinessItems(view: ReadinessView): ReadinessGroup[] {
+  const doFirst: ReadinessViewItem[] = [];
+  const blocked: ReadinessViewItem[] = [];
+  const inSprint: ReadinessViewItem[] = [];
+  const done: ReadinessViewItem[] = [];
+
+  for (const it of view.items) {
+    if (it.status === "done") {
+      done.push(it);
+    } else if (it.status === "blocked") {
+      blocked.push(it);
+    } else if (it.owner_class === "owner-action") {
+      doFirst.push(it);
+    } else {
+      inSprint.push(it);
+    }
+  }
+
+  const groups: ReadinessGroup[] = [
+    {
+      key: "do-first",
+      heading: "Do this first",
+      items: orderDoFirst(doFirst),
+      collapsedByDefault: false,
+    },
+    { key: "blocked", heading: "Blocked", items: blocked, collapsedByDefault: false },
+    {
+      key: "in-sprint",
+      heading: "In the sprint",
+      items: inSprint,
+      collapsedByDefault: false,
+    },
+    {
+      key: "done",
+      heading: `Done (${done.length})`,
+      items: done,
+      collapsedByDefault: true,
+    },
+  ];
+
+  return groups.filter((g) => g.items.length > 0);
+}
